{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Job": {
        "properties": {
          "attempts": {
            "description": "how many times the job started running; a failed run is retried",
            "title": "Attempts",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Params",
            "type": "object"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "start of the latest attempt",
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "attempts",
          "created_at",
          "started_at",
          "params"
        ],
        "title": "Job",
        "type": "object"
      },
      "JobKind": {
        "enum": [
          "pipeline",
          "dbt_build",
          "parity"
        ],
        "title": "JobKind",
        "type": "string"
      },
      "JobRequest": {
        "additionalProperties": false,
        "description": "Start a pipeline run or a dbt build. Both run against the local DuckDB file only.",
        "properties": {
          "kind": {
            "enum": [
              "pipeline",
              "dbt_build"
            ],
            "title": "Kind",
            "type": "string"
          },
          "select": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+:*,@/-]{0,99}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "dbt_build only: a dbt node selection, e.g. `marts` or `+fct_orders`",
            "title": "Select"
          },
          "until": {
            "anyOf": [
              {
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "pipeline only: load order months up to this one, YYYY-MM (default: all)",
            "title": "Until"
          }
        },
        "required": [
          "kind"
        ],
        "title": "JobRequest",
        "type": "object"
      },
      "JobResult": {
        "properties": {
          "artifact": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "repo path of the file the job leaves behind, if any",
            "title": "Artifact"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "output_tail": {
            "description": "last lines of the job's output",
            "title": "Output Tail",
            "type": "string"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "exit_code",
          "summary",
          "output_tail",
          "artifact"
        ],
        "title": "JobResult",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "ParityRequest": {
        "additionalProperties": false,
        "description": "Start the T-SQL / Spark parity check (`tsql_parity/`).",
        "properties": {
          "skip_load": {
            "default": false,
            "description": "SQL Server tables are already loaded",
            "title": "Skip Load",
            "type": "boolean"
          }
        },
        "title": "ParityRequest",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 7807 problem details (`application/problem+json`).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HMACSignature": {
        "description": "Hex HMAC-SHA256 over timestamp, nonce, method, path with query and raw body, joined by newlines, with the headers X-Timestamp (unix seconds, 5 minute window) and X-Nonce (16-64 characters, used once).",
        "in": "header",
        "name": "X-Signature",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Start and follow pipeline runs, dbt builds and the T-SQL / Spark parity check.",
    "title": "Olist job control",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Process is up",
        "tags": [
          "ops"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          }
        },
        "summary": "Job store is reachable",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/jobs": {
      "post": {
        "operationId": "create_job_v1_jobs_post",
        "parameters": [
          {
            "description": "Client-chosen key; the same key with the same body returns the same job",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "description": "Client-chosen key; the same key with the same body returns the same job",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          }
        },
        "security": [
          {
            "HMACSignature": []
          }
        ],
        "summary": "Start a pipeline run or a dbt build",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job_v1_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HMACSignature": []
          }
        ],
        "summary": "Job status",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/jobs/{job_id}/result": {
      "get": {
        "operationId": "get_result_v1_jobs__job_id__result_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HMACSignature": []
          }
        ],
        "summary": "Outcome of a finished job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/parity/run": {
      "post": {
        "operationId": "run_parity_v1_parity_run_post",
        "parameters": [
          {
            "description": "Client-chosen key; the same key with the same body returns the same job",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "description": "Client-chosen key; the same key with the same body returns the same job",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details"
          }
        },
        "security": [
          {
            "HMACSignature": []
          }
        ],
        "summary": "Start the T-SQL / Spark parity check",
        "tags": [
          "jobs"
        ]
      }
    }
  }
}
