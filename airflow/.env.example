# Copy to airflow/.env (gitignored). Compose reads it for variable substitution.

# Service-account key on the host (same file GOOGLE_APPLICATION_CREDENTIALS points
# to). Unset = no BigQuery DAG; the DuckDB DAG works without it.
# GCP_KEY_FILE=C:/Users/you/keys/olist-dbt-runner.json

# Linux hosts: your uid, so files written to the mounted repo are yours
# AIRFLOW_UID=1000

# Alert emails through a real SMTP server instead of the local Mailpit (default).
# Airflow connection URI; URL-encode @ and special characters in user/password.
# Gmail: 2-step verification + an app password (https://myaccount.google.com/apppasswords),
# port 587 = STARTTLS, so only disable_ssl. Recipients: Airflow Variable olist_alert_emails.
# SMTP_CONN=smtp://you%40gmail.com:app-password@smtp.gmail.com:587?disable_ssl=true&from_email=you%40gmail.com
